# Env — Supabase keys land here from Session 1 on. Never commit these.
.env
.env.*
!.env.example

# Auto-generated by the TanStack Router plugin on every `vite dev` /
# `vite build` — never hand-edited, never committed.
src/routeTree.gen.ts

# src/types/database.generated.ts is NOT ignored, unlike the above: it
# only updates via an explicit, infrequent `pnpm db:types` run against a
# live Supabase instance, not automatically on every dev/build. It's
# committed so `pnpm typecheck`/`pnpm build` work for anyone cloning the
# repo without running codegen first — still never hand-edited once real
# generated output exists (CLAUDE.md §3).

