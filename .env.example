# Copy to .env.local (gitignored) and fill in real values from your
# Supabase project settings (Project Settings > API). Never commit
# .env.local or any file containing real values — only this template.

# Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Project Settings > API > Project API keys > anon / public
# Safe to expose client-side by design — RLS is what actually protects
# data, not secrecy of this key. Still never commit it out of habit.
VITE_SUPABASE_ANON_KEY=

# service_role key is NEVER placed in this file, or in any file under
# src/. It belongs only in Supabase Edge Function secrets / server-side
# environments — see CLAUDE.md §7.
